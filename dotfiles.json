{
  "setup": [
    {
      "name": "gitconfig",
      "run": ["bash", "home/.local/share/helpers/sh/init-gitconfig.sh"],
      "creates": ".gitconfig"
    },
    {
      "name": "local",
      "run": ["bash", "home/.local/share/helpers/sh/init-local.sh"],
      "creates": ".bashrc.d/local.sh"
    },
    {
      "name": "oh-my-posh",
      "run": ["bash", "home/.local/share/helpers/sh/install-oh-my-posh.sh"],
      "provides": "oh-my-posh"
    },
    {
      "name": "meslo-nerd-font",
      "run": ["oh-my-posh", "font", "install", "Meslo"],
      "creates": ".local/share/fonts/meslolgl-nerd-font/MesloLGLNerdFont-Regular.ttf"
    },
    {
      "name": "dotnet-sdk",
      "run": ["bash", "home/.local/share/helpers/sh/install-dotnet.sh"],
      "creates": ".dotnet/dotnet"
    },
    {
      "name": "vscode",
      "run": ["bash", "home/.local/share/helpers/sh/install-vscode.sh"],
      "provides": "code"
    }
  ]
}
