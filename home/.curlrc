# curl configuration: read by every curl run, interactive or scripted, unless
# its first option is -q (--disable). https://curl.se/docs/manpage.html#-K
# Keep it to display preferences. Options such as insecure or location would
# silently change how every script that calls curl behaves; the helpers in
# ~/.local/share/helpers/sh pass --disable so this file never affects them.

# Show a single progress bar instead of the statistics table.
progress-bar
